# .NET
bin/
obj/
*.user

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Generated protobuf stubs — Python only.
# The Go stubs (synthetic/workerv1/*.pb.go) ARE committed, deliberately: it is the
# Go convention, and it keeps `go build ./...` working from a fresh clone with no
# protoc installed. Python's are regenerated by scripts/e2e.sh instead.
**/*_pb2.py
**/*_pb2_grpc.py
**/*_pb2.pyi

# Go
synthetic/synthetic
*.test

# Secrets — nothing credential-shaped is ever committed. See docs/SPEC.md §5.
.env
*.pem
*.key
credentials/

# macOS
.DS_Store
